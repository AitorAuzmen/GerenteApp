<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Pane?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/25"
            fx:controller="kontrola.LehioNagusiaController"
            style="-fx-background-color: #F4F4F4;">

    <left>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="NEVER"
                    style="-fx-background: transparent; -fx-background-color: transparent;">
            <content>
                <VBox spacing="15"
                      style="-fx-background-color: #E67E22; -fx-padding: 25;">

                    <Label text="JAUS"
                           style="-fx-text-fill: white;
                                  -fx-font-size: 26px;
                                  -fx-font-weight: bold;" />

                    <Label text="" style="-fx-padding: 10 0 0 0;" />

                    <Button fx:id="btnProduktuak"
                            text="Produktuak"
                            prefWidth="180"
                            onAction="#kargatuProduktuak"
                            style="-fx-font-size: 18px;
                                   -fx-text-fill: white;
                                   -fx-background-color: transparent;
                                   -fx-background-radius: 5;
                                   -fx-padding: 10 0 10 10;" />

                    <Button text="Kategoriak" prefWidth="180"
                            style="-fx-font-size: 18px;
                                   -fx-text-fill: white;
                                   -fx-background-color: transparent;" />

                    <Button text="Mahaiak" prefWidth="180"
                            style="-fx-font-size: 18px;
                                   -fx-text-fill: white;
                                   -fx-background-color: transparent;" />

                    <Button fx:id="btnErabiltzaileak"
                            prefWidth="180"
                            text="Erabiltzaileak"
                            onAction="#kargatuErabiltzaileak"
                            style="-fx-font-size: 18px;
                                   -fx-text-fill: white;
                                   -fx-background-color: transparent;
                                   -fx-background-radius: 5;
                                   -fx-padding: 10 0 10 10;" />

                    <Button text="Rolak" prefWidth="180"
                            style="-fx-font-size: 18px;
                                   -fx-text-fill: white;
                                   -fx-background-color: transparent;" />

                    <Button text="Osagaiak" prefWidth="180"
                            style="-fx-font-size: 18px;
                                   -fx-text-fill: white;
                                   -fx-background-color: transparent;" />

                    <!-- Relleno para que la barra naranja llegue hasta abajo -->
                    <Pane VBox.vgrow="ALWAYS" />

                </VBox>
            </content>
        </ScrollPane>
    </left>

    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 40;">
            <Label text="Hemen agertuko da edukia (taulak, datuak, pantailak...)"
                   style="-fx-font-size: 20px; -fx-text-fill: #555;" />
        </StackPane>
    </center>

</BorderPane>
